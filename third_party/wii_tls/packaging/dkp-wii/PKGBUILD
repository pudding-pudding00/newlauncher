# Maintainer: pudding-pudding00
pkgname=wii-libwiitls
pkgver=1.1.1
pkgrel=1
pkgdesc='Modern TLS 1.3/1.2, HTTP/2 and HTTP/1.1 client library for Nintendo Wii homebrew'
arch=('any')
url='https://github.com/pudding-pudding00/libwiitls'
license=('Apache-2.0' 'MPL-2.0' 'Zlib')
options=(!strip libtool staticlibs)
depends=('devkitPPC' 'libogc')
makedepends=('dkp-toolchain-vars')
groups=('wii-portlibs')

# Local tree build by default (override source/srcdir for tarball releases).
_srcroot="${WTLS_SRC_ROOT:-$startdir/../..}"

build() {
  source "${DEVKITPRO}/wii_vars.sh" 2>/dev/null || true

  cmake -S "$_srcroot" -B "$srcdir/build-pkg" \
    -DCMAKE_TOOLCHAIN_FILE="${DEVKITPRO}/cmake/Wii.cmake" \
    -DCMAKE_INSTALL_PREFIX="${PORTLIBS_PREFIX:-/opt/devkitpro/portlibs/wii}" \
    -DWTLS_BUILD_HWTEST=OFF \
    -DWTLS_BUILD_BENCH=OFF \
    -DWTLS_BUILD_EXAMPLES=OFF \
    -DWTLS_INSTALL_ISOLATED_DEPS=ON \
    ${WTLS_EMBED_CA:+-DWTLS_EMBED_CA=$WTLS_EMBED_CA}

  cmake --build "$srcdir/build-pkg" -j"$(nproc 2>/dev/null || echo 4)"
}

package() {
  DESTDIR="$pkgdir" cmake --install "$srcdir/build-pkg"
  rm -f "$pkgdir${PORTLIBS_PREFIX:-/opt/devkitpro/portlibs/wii}/lib/libmbedcrypto.a" \
        "$pkgdir${PORTLIBS_PREFIX:-/opt/devkitpro/portlibs/wii}/lib/wiitls/libmbedcrypto.a"

  install -Dm644 "$_srcroot/LICENSE" \
    "$pkgdir${PORTLIBS_PREFIX:-/opt/devkitpro/portlibs/wii}/licenses/$pkgname/LICENSE"
}
